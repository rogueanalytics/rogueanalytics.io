# Public build settings. Vite bakes these into the site, so never put secrets here.
# Members area (Discord login, Projections, Gamebooks). Keep false until Phases 2-4 are done.
VITE_MEMBERS_ENABLED=false
# Shown in the footer and contact section. Leave blank to hide.
VITE_CONTACT_EMAIL=
# Formspree form ID for the Analytics contact form (the part after /f/). Leave blank to fall back to email.
VITE_FORMSPREE_ID=
